{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "TodoNamespace",
        "Topics": [
          {
            "Name": "notification-events",

            "Properties": {
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT20S",
              "RequiresDuplicateDetection": false
            },

            "Subscriptions": [
              {
                "Name": "realtime",

                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 10
                }
              },

              {
                "Name": "email"
              }
            ]
          }
        ]
      }
    ],
    "Logging": {
      "Type": "File"
    }
  }
}